# Copy to .env (git-ignored) and fill in. Nothing here is ever logged or shown.

# --- Agent mailbox (email connector; docs/EMAIL.md) ---
# A dedicated mailbox for the agent. For Gmail: turn on 2-step verification,
# create an App password, and make sure IMAP is enabled in Gmail settings.
RECEIPT_IMAP_USER=agent.mailbox@gmail.com
RECEIPT_IMAP_PASSWORD=xxxx xxxx xxxx xxxx
RECEIPT_IMAP_HOST=imap.gmail.com
RECEIPT_IMAP_SENT_FOLDER=[Gmail]/Sent Mail
RECEIPT_IMAP_ALERTS_FOLDER=INBOX
# How this mailbox appears in the Agent column (default: "mailbox <user>")
RECEIPT_EMAIL_AGENT=test-agent mailbox

# Used only by examples/send_test_email.py and examples/send_fake_card_alert.py
RECEIPT_SMTP_HOST=smtp.gmail.com
RECEIPT_SMTP_PORT=587

# --- Calendar (docs/CALENDAR.md) ---
# Watch the macOS Calendar app (and everything it syncs) for events created,
# changed, or deleted. macOS will ask once for calendar permission.
RECEIPT_CALENDAR=off
# Optional: only these calendars, comma-separated (default: all)
RECEIPT_CALENDARS=
# How this appears in the Agent column (default: "calendar")
RECEIPT_CALENDAR_AGENT=calendar

# --- Stripe (card connector; docs/STRIPE.md) ---
# Test mode: Dashboard → Test mode → Developers → API keys → Secret key (sk_test_...).
# Fake money only. A live key (RECEIPT_STRIPE_KEY=sk_live_...) is also accepted.
RECEIPT_STRIPE_TEST_KEY=sk_test_...
# How this appears in the Agent column (default: "stripe card (test mode)")
RECEIPT_STRIPE_AGENT=test-agent card
